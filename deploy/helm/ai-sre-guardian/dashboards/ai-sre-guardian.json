      "targets": [{"expr": "sum(ai_sre_capacity_active_requests{namespace=\"ai-sre-lab\",service=\"ai-sre-capacity-lab\"})", "legendFormat": "active", "refId": "A"}],
      "title": "Active Capacity Requests",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 4, "y": 11},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (strategy, outcome) (rate(ai_sre_resilience_requests_total{namespace=\"ai-sre-lab\",service=\"ai-sre-capacity-lab\"}[5m]))", "legendFormat": "{{strategy}} / {{outcome}}", "refId": "A"}],
      "title": "Resilience Request Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
