      "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"ai-sre-lab\",pod=~\"ai-sre-capacity-lab-.+\",container=\"api\"}[5m]))", "legendFormat": "{{pod}}", "refId": "A"}],
      "title": "Pod CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
